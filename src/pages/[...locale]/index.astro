---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import PlatformIcon from "../../components/PlatformIcon.astro";
import WindowFrame from "../../components/WindowFrame.astro";
import PhoneFrame from "../../components/PhoneFrame.astro";
import Disclosure from "../../components/Disclosure.astro";
import NotStated from "../../components/NotStated.astro";
import TypedCode from "../../components/TypedCode.astro";
import { localeFromPath, localeParams, useT } from "../../i18n";
import { getData, isLive, isReferral, type Service } from "../../data";
import { docs, repo, rivals, feeds } from "../../lib/links";
import { CATEGORY_ORDER, FEATURED, categoryIcon } from "../../lib/catalog";

import heroImg from "../../assets/shots/hero.png";
import heroMobileImg from "../../assets/shots/hero-mobile.png";
import fleetImg from "../../assets/shots/fleet.png";
import fleetCrop from "../../assets/shots/fleet-crop.png";
import catalogImg from "../../assets/shots/catalog.png";
import catalogCrop from "../../assets/shots/catalog-crop.png";
import payoutsImg from "../../assets/shots/payouts.png";
import payoutsCrop from "../../assets/shots/payouts-crop.png";
import desktopImg from "../../assets/shots/desktop-dashboard.png";
import desktopCrop from "../../assets/shots/desktop-crop.png";
import androidImg from "../../assets/shots/android-home.png";
import androidCrop from "../../assets/shots/android-crop.png";
import { catalogText } from "../../lib/catalog-text";

export const getStaticPaths = () => localeParams();

const t = useT(localeFromPath(Astro.params.locale));
const data = await getData();
const live = data.services.filter(isLive);

const categories = CATEGORY_ORDER.map((key) => ({
  key,
  count: live.filter((s) => s.category === key).length,
})).filter((c) => c.count > 0);

// A few services from each group (FEATURED in src/lib/catalog.ts).
const featured: Service[] = CATEGORY_ORDER.flatMap((cat) => {
  const { count, slugs } = FEATURED[cat];
  const inCat = live.filter((s) => s.category === cat);
  const picked = slugs
    ? slugs.map((slug) => inCat.find((s) => s.slug === slug)).filter((s): s is Service => Boolean(s))
    : inCat.filter((s) => s.priority !== null).sort((a, b) => a.priority! - b.priority!);
  return picked.slice(0, count);
});

const platforms = [
  { key: "windows", href: "/download/windows/" },
  { key: "macos", href: "/download/macos/" },
  { key: "linux", href: "/download/linux/" },
  { key: "android", href: "/download/android/" },
  { key: "docker", href: "/download/docker/" },
  { key: "pi", href: "/download/docker/" },
] as const;

// Each tour crop links to the whole screen as a webp, so no lightbox script is needed.
const fullUrl = async (img: ImageMetadata) => (await getImage({ src: img, format: "webp" })).src;
const tour = [
  { key: "fleet", crop: fleetCrop, full: await fullUrl(fleetImg), title: "localhost:8080/fleet" },
  { key: "catalog", crop: catalogCrop, full: await fullUrl(catalogImg), title: "localhost:8080/catalog" },
  { key: "payouts", crop: payoutsCrop, full: await fullUrl(payoutsImg), title: "localhost:8080/payouts" },
] as const;
const desktopFull = await fullUrl(desktopImg);
const androidFull = await fullUrl(androidImg);

// Comparison facts, checked on 2026-11-04 against each project's repository.
// Sources for every cell: docs/comparison.md in the CashPilot repo.
const COMPARE_DATE = "2026-11-04T00:00:00Z";
type Cell = "yes" | "no" | string;
const compareCols = [
  { name: "CashPilot", url: repo.web },
  { name: "money4band", url: rivals.money4band },
  { name: "income-generator", url: rivals.igm },
  { name: "InternetIncome", url: rivals.internetIncome },
  { name: "CashFactory", url: rivals.cashFactory },
];
const compareRows: { key: string; cells: Cell[] }[] = [
  { key: "license", cells: ["values.gpl", "values.gpl", "values.proprietary", "values.noLicense", "values.gplReadme"] },
  // Security rows: "LAN isolation", "Earner container settings" and "Docker socket mounted into" in docs/comparison.md.
  { key: "lanIsolation", cells: ["yes", "values.lanReachable", "no", "no", "no"] },
  { key: "lockedDown", cells: ["yes", "values.partly", "no", "no", "no"] },
  { key: "dockerAccess", cells: ["yes", "no", "values.updaterHardened", "no", "no"] },
  { key: "balances", cells: ["yes", "values.estimates", "no", "no", "no"] },
  { key: "fleet", cells: ["yes", "no", "values.claimed", "no", "no"] },
  { key: "desktop", cells: ["yes", "no", "no", "no", "no"] },
  { key: "android", cells: ["yes", "no", "no", "no", "no"] },
  { key: "gpu", cells: ["values.betaMining", "no", "no", "no", "no"] },
];
const cellText = (c: Cell) => (c === "yes" ? t("common.yes") : c === "no" ? t("common.no") : t(`home.compare.${c}`));

const faqVars = {
  securityUrl: docs.homeSecurity,
  referralsUrl: t.href("/referrals/"),
  armUrl: docs.arm,
  privacyUrl: t.href("/privacy/"),
};
---
<Base t={t} route="/" title={t("home.title")} description={t("home.description")}>
  <section class="hero">
    <div class="container hero__inner">
      <p class="pill"><Icon name="check" />{t("home.hero.pill")}</p>
      <h1 class="hero__title">{t("home.hero.title")}</h1>
      <p class="hero__lead">{t("home.hero.lead")}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href={t.href("/download/")}><Icon name="download" />{t("home.hero.download")}</a>
        <a class="btn btn--ghost" href={t.href("/download/docker/")}><PlatformIcon name="docker" />{t("home.hero.selfhost")}</a>
      </div>
      <p class="hero__expect">{t("home.hero.expect")}</p>
      <div class="stats-line">
        <dl class="stats" aria-label={t("home.stats.label")}>
          <div>
            <dt>{t("home.stats.stars")}</dt>
            <dd class="num">{t.num(data.stars.web)}</dd>
          </div>
          <div>
            <dt>{t("home.stats.pulls")}</dt>
            <dd class="num">{t.num(data.pulls.ui)}</dd>
          </div>
          <div>
            <dt>{t("home.stats.services")}</dt>
            <dd class="num">{t.num(live.length)}</dd>
          </div>
        </dl>
        <p class="stats__note">{t("home.stats.note", { date: t.date(data.fetchedAt) })}</p>
      </div>
    </div>
    <div class="container hero__shot">
      <div class="hero__glow" aria-hidden="true"></div>
      <WindowFrame src={heroImg} alt={t("home.hero.imageAlt")} title="localhost:8080" eager class="hero__desktop" />
      <PhoneFrame src={heroMobileImg} alt={t("home.hero.imageAltMobile")} eager class="hero__phone" />
    </div>
  </section>

  <section class="platforms" aria-labelledby="platforms-title">
    <div class="container platforms__inner">
      <h2 id="platforms-title" class="platforms__title">{t("home.platforms.title")}</h2>
      <ul class="platforms__list">
        {
          platforms.map((p) => (
            <li>
              <a href={t.href(p.href)}>
                <PlatformIcon name={p.key} />
                <span>{t(`home.platforms.${p.key}`)}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="how-title">
    <div class="container">
      <div class="section-head">
        <h2 id="how-title">{t("home.how.title")}</h2>
        <p>{t("home.how.lead")}</p>
      </div>
      <ol class="steps">
        {
          t.keys("home.how.steps").map((k, i) => (
            <li class="card step">
              <span class="step__num num" aria-hidden="true">{i + 1}</span>
              <h3>{t(`home.how.steps.${k}.title`)}</h3>
              <p>{t(`home.how.steps.${k}.text`)}</p>
            </li>
          ))
        }
      </ol>

      <div class="cats">
        <h3 class="cats__title">{t("home.categories.title", { count: t.num(live.length) })}</h3>
        <ul class="cats__grid">
          {
            categories.map((c) => (
              <li class="cat">
                <span class="cat__icon">
                  <Icon name={categoryIcon[c.key]!} />
                </span>
                <span class="cat__body">
                  <span class="cat__name">{t(`home.categories.${c.key}.name`)}</span>
                  <span class="cat__count num">{t("home.categories.count", { count: t.num(c.count) })}</span>
                  <span class="cat__text">{t(`home.categories.${c.key}.text`)}</span>
                </span>
              </li>
            ))
          }
          <li class="cat cat--all">
            <a href={docs.guides}>
              <span class="cat__icon">
                <Icon name="arrow" class="flip" />
              </span>
              <span class="cat__body">
                <span class="cat__name">{t("home.categories.all.name", { count: t.num(live.length) })}</span>
                <span class="cat__text">{t("home.categories.all.text")}</span>
              </span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="tour-title">
    <div class="container">
      <div class="section-head">
        <h2 id="tour-title">{t("home.tour.title")}</h2>
        <p>{t("home.tour.lead")}</p>
      </div>
      <ul class="tour">
        {
          tour.map((s) => (
            <li>
              <figure>
                <WindowFrame
                  src={s.crop}
                  alt={t(`home.tour.${s.key}.alt`)}
                  title={s.title}
                  href={s.full}
                  sizes="(min-width: 1160px) 540px, (min-width: 760px) 46vw, 100vw"
                />
                <figcaption>
                  <h3>{t(`home.tour.${s.key}.title`)}</h3>
                  <p>{t(`home.tour.${s.key}.text`)}</p>
                </figcaption>
              </figure>
            </li>
          ))
        }
        <li>
          <figure>
            <WindowFrame src={desktopCrop} alt={t("home.tour.desktop.alt")} bare href={desktopFull} sizes="(min-width: 1160px) 540px, (min-width: 760px) 46vw, 100vw" />
            <figcaption>
              <h3>{t("home.tour.desktop.title")}</h3>
              <p>{t("home.tour.desktop.text")}</p>
            </figcaption>
          </figure>
        </li>
        <li class="tour__wide">
          <figure class="tour__phone">
            <PhoneFrame src={androidCrop} alt={t("home.tour.android.alt")} href={androidFull} />
            <figcaption>
              <h3>{t("home.tour.android.title")}</h3>
              <p>{t("home.tour.android.text")}</p>
            </figcaption>
          </figure>
        </li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="catch-title">
    <div class="container">
      <div class="section-head">
        <h2 id="catch-title">{t("home.catch.title")}</h2>
        <p>{t("home.catch.lead")}</p>
      </div>
      <ul class="grid catch">
        {
          (["free", "open", "hardware", "account"] as const).map((k) => (
            <li class="card">
              <h3>{t(`home.catch.${k}.title`)}</h3>
              <p>{t(`home.catch.${k}.text`)}</p>
            </li>
          ))
        }
      </ul>
      <p class="catch__funding">
        {t("home.catch.funding")} <a href={t.href("/referrals/")}>{t("disclosure.more")}</a>
      </p>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="control-title">
    <div class="container split">
      <div>
        <div class="section-head">
          <h2 id="control-title">{t("home.control.title")}</h2>
          <p>{t("home.control.lead")}</p>
        </div>
        <ul class="feature-list">
          {
            (
              [
                ["logins", "lock"],
                ["containers", "box"],
                ["lan", "home"],
                ["stop", "power"],
              ] as const
            ).map(([k, icon]) => (
              <li>
                <span class="feature-list__icon">
                  <Icon name={icon} />
                </span>
                <div>
                  <h3>{t(`home.control.${k}.title`)}</h3>
                  <p set:html={t(`home.control.${k}.text`, { securityUrl: docs.homeSecurity })} />
                </div>
              </li>
            ))
          }
        </ul>
        <p class="split__note">
          <Icon name="shield" />
          <span>
            {t("home.control.ratings")}{" "}
            <a href={docs.ratings}>{t("home.control.ratingsLink")}</a>
          </span>
        </p>
      </div>
      <div>
        <div class="section-head">
          <h2 id="earnings-title">{t("home.earnings.title")}</h2>
          <p>{t("home.earnings.lead")}</p>
        </div>
        <ul class="factors">
          {
            (
              [
                ["country", "map"],
                ["ip", "router"],
                ["connection", "wifi"],
                ["uptime", "clock"],
                ["devices", "devices"],
                ["hardware", "chip"],
              ] as const
            ).map(([k, icon]) => (
              <li>
                <Icon name={icon} />
                <div>
                  <h3>{t(`home.earnings.${k}.title`)}</h3>
                  <p>{t(`home.earnings.${k}.text`)}</p>
                </div>
              </li>
            ))
          }
        </ul>
        <p class="split__note">
          <Icon name="info" />
          <span>{t("home.earnings.note")}</span>
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="services-title">
    <div class="container">
      <div class="section-head">
        <h2 id="services-title">{t("home.services.title")}</h2>
        <p>{t("home.services.lead")}</p>
      </div>
      <Disclosure t={t} />
      <div class="table-wrap services-table" role="region" aria-labelledby="services-caption" tabindex="0">
        <table>
          <caption id="services-caption" class="visually-hidden">{t("home.services.caption")}</caption>
          <thead>
            <tr>
              <th scope="col">{t("home.services.col.service")}</th>
              <th scope="col">{t("home.services.col.homeIp")}</th>
              <th scope="col">{t("home.services.col.devicesPerIp")}</th>
              <th scope="col">{t("home.services.col.payout")}</th>
              <th scope="col">{t("home.services.col.minimum")}</th>
              <th scope="col"><span class="visually-hidden">{t("home.services.signup")}</span></th>
            </tr>
          </thead>
          <tbody>
            {
              featured.map((s) => {
                const ref = isReferral(s);
                const payout = s.paymentMethods.map((m) => t(`payment.${m}`)).join(", ");
                const minimum = catalogText(data, t, s, "payment.minimum_payout");
                return (
                  <tr>
                    <th scope="row">
                      <a class="svc-name" href={docs.guide(s.slug)} aria-label={t("home.services.guideLabel", { name: s.name })}>
                        {s.name}
                      </a>
                      <span class="svc-cat">{t(`categories.${s.category}`)}</span>
                    </th>
                    <td data-label={t("home.services.col.homeIp")}>
                      {s.residentialIp === null ? <NotStated t={t} /> : s.residentialIp ? t("common.yes") : t("common.no")}
                    </td>
                    <td data-label={t("home.services.col.devicesPerIp")}>
                      {s.devicesPerIp === null ? (
                        <NotStated t={t} />
                      ) : s.devicesPerIp === 0 ? (
                        t("common.noLimit")
                      ) : (
                        <span class="num">{t.num(s.devicesPerIp)}</span>
                      )}
                    </td>
                    <td class="wrap" data-label={t("home.services.col.payout")}>
                      {payout || <NotStated t={t} />}
                    </td>
                    <td class="wrap" data-label={t("home.services.col.minimum")}>
                      {minimum ? <span lang={minimum.lang}>{minimum.text}</span> : <NotStated t={t} />}
                    </td>
                    <td class="signup">
                      {s.signupUrl && (
                        <a
                          class="btn btn--ghost btn--sm"
                          href={s.signupUrl}
                          rel={ref ? "sponsored noopener" : "noopener"}
                          aria-label={t(ref ? "home.services.signupLabel" : "home.services.signupLabelPlain", { name: s.name })}
                        >
                          {t("home.services.signup")}
                        </a>
                      )}
                      <TypedCode t={t} service={s} idPrefix="home" />
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
      <p class="services__note">{t("home.services.notStatedNote")}</p>
      <p class="links-row">
        <a href={docs.guides}>{t("home.services.all", { count: t.num(live.length) })} <Icon name="arrow" class="flip" /></a>
        <a href={t.href("/referrals/")}>{t("home.services.referrals")} <Icon name="arrow" class="flip" /></a>
      </p>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="faq-title">
    <div class="container">
      <div class="section-head">
        <h2 id="faq-title">{t("home.faq.title")}</h2>
      </div>
      <div class="faq">
        {
          t.keys("home.faq.items").map((k) => (
            <details class="faq__item">
              <summary>
                <span class="faq__q">{t(`home.faq.items.${k}.q`)}</span>
                <Icon name="chevron" class="faq__chev" />
              </summary>
              <p set:html={t(`home.faq.items.${k}.a`, faqVars)} />
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt section--cont" aria-labelledby="compare-title">
    <div class="container">
      <div class="section-head">
        <h2 id="compare-title">{t("home.compare.title")}</h2>
        <p>{t("home.compare.lead", { date: t.date(COMPARE_DATE) })}</p>
      </div>
      <div class="table-wrap compare-table" role="region" aria-labelledby="compare-caption" tabindex="0">
        <table>
          <caption id="compare-caption" class="visually-hidden">{t("home.compare.caption")}</caption>
          <thead>
            <tr>
              <th scope="col">{t("home.compare.feature")}</th>
              {
                compareCols.map((c, i) => (
                  <th scope="col" class:list={{ "is-us": i === 0 }}>
                    <a href={c.url}>{c.name}</a>
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              compareRows.map((r) => (
                <tr>
                  <th scope="row">{t(`home.compare.rows.${r.key}`)}</th>
                  {r.cells.map((c, i) => (
                    <td class:list={{ "is-us": i === 0 }}>
                      {c === "yes" ? (
                        <span class="yes">
                          <Icon name="check" />
                          {t("common.yes")}
                        </span>
                      ) : c === "no" ? (
                        <span class="no">
                          <Icon name="dash" />
                          {t("common.no")}
                        </span>
                      ) : (
                        cellText(c)
                      )}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="compare-note" set:html={t("home.compare.security", { securityUrl: docs.securityDefaults })} />
      <p class="links-row">
        <a href={docs.comparison}>{t("home.compare.more")} <Icon name="arrow" class="flip" /></a>
      </p>
    </div>
  </section>

  <section class="section cta-section" aria-labelledby="cta-title">
    <div class="container">
      <div class="cta">
        <h2 id="cta-title">{t("home.cta.title")}</h2>
        <p>{t("home.cta.text")}</p>
        <div class="hero__actions">
          <a class="btn btn--primary" href={t.href("/download/")}><Icon name="download" />{t("home.cta.download")}</a>
          <a class="btn btn--ghost" href={repo.web}><PlatformIcon name="github" />{t("home.cta.github")}</a>
        </div>
        <p class="cta__releases" set:html={t("home.cta.releases", { feedUrl: feeds.releases })} />
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding-top: clamp(2.25rem, 5vw, 4rem);
    overflow: hidden;
  }
  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--accent-line);
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--text);
    font-size: 0.875rem;
    font-weight: 500;
  }
  .pill :global(.icon) {
    width: 1rem;
    height: 1rem;
    color: var(--accent);
  }
  .hero__title {
    margin-top: 1.25rem;
    max-width: 34ch;
    font-size: clamp(2.25rem, 4.2vw, 3.3rem);
    line-height: 1.06;
    letter-spacing: -0.035em;
  }
  .hero__lead {
    margin-top: 1.2rem;
    max-width: 42rem;
    color: var(--muted);
    font-size: clamp(1.0625rem, 1.5vw, 1.1875rem);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  .hero__expect {
    margin-top: 1rem;
    max-width: 52rem;
    color: var(--faint);
    font-size: 0.9375rem;
  }
  .stats-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.25rem 1.25rem;
    margin-top: 0.75rem;
    font-size: 0.9375rem;
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1.25rem;
    margin: 0;
  }
  .stats div {
    display: flex;
    flex-direction: row-reverse;
    align-items: baseline;
    gap: 0.35rem;
  }
  .stats dt {
    color: var(--muted);
  }
  .stats dd {
    margin: 0;
    font-weight: 700;
    color: var(--text);
  }
  .stats__note {
    color: var(--faint);
    font-size: 0.8125rem;
  }
  .hero__shot {
    position: relative;
    margin-top: clamp(2rem, 4vw, 2.75rem);
  }
  .hero__glow {
    position: absolute;
    inset: -10% 5% auto;
    height: 70%;
    background:
      radial-gradient(50% 60% at 30% 40%, rgb(251 113 133 / 0.22), transparent 70%),
      radial-gradient(45% 55% at 75% 35%, rgb(255 152 0 / 0.14), transparent 70%);
    filter: blur(30px);
    pointer-events: none;
  }
  .hero__shot :global(.hero__phone) {
    display: none;
  }
  .hero__shot :global(.window) {
    position: relative;
    mask-image: linear-gradient(to bottom, #000 78%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, #000 78%, transparent 100%);
  }
  /* The one effect on the site: the hero window fades in and rises 8 px. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__shot :global(.window),
    .hero__shot :global(.phone) {
