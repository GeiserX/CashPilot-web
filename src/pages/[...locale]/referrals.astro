---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Disclosure from "../../components/Disclosure.astro";
import TypedCode from "../../components/TypedCode.astro";
import { localeFromPath, localeParams, useT } from "../../i18n";
import { getData, isLive, isReferral } from "../../data";
import { docs } from "../../lib/links";
import { CATEGORY_ORDER, categoryIcon } from "../../lib/catalog";
import { catalogText } from "../../lib/catalog-text";

export const getStaticPaths = () => localeParams();
const t = useT(localeFromPath(Astro.params.locale));
const data = await getData();
const referrals = data.services.filter((s) => isLive(s) && isReferral(s));
const bonus = (s: (typeof referrals)[number]) => catalogText(data, t, s, "referral.bonus.referee");
const groups = CATEGORY_ORDER.map((key) => ({
  key,
  services: referrals.filter((s) => s.category === key),
})).filter((g) => g.services.length > 0);
---
<Base t={t} route="/referrals/" title={t("referrals.metaTitle")} description={t("referrals.description")}>
  <section class="page-hero">
    <div class="container">
      <h1>{t("referrals.title")}</h1>
      <p>{t("referrals.lead")}</p>
    </div>
  </section>

  <div class="container ref">
    <section class="ref__how card" aria-labelledby="how-title">
      <h2 id="how-title">{t("referrals.howTitle")}</h2>
      <ul>
        <li>{t("disclosure.short")}</li>
        <li>{t("referrals.how2")}</li>
      </ul>
    </section>

    <p class="ref__count">{t("referrals.count", { count: t.num(referrals.length), date: t.date(data.fetchedAt) })}</p>

    <nav class="ref__toc" aria-label={t("referrals.toc")}>
      <ul>
        {
          groups.map((g) => (
            <li>
              <a href={`#${g.key}`}>
                {t(`categories.${g.key}`)} <span class="ref__toc-count">{t("referrals.tocCount", { count: t.num(g.services.length) })}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      groups.map((g) => (
        <section class="ref__group" id={g.key} aria-labelledby={`h-${g.key}`}>
          <h2 id={`h-${g.key}`}>
            <Icon name={categoryIcon[g.key]!} />
            {t(`categories.${g.key}`)}
          </h2>
          <Disclosure t={t} noLink />
          <div class="table-wrap ref__table">
            <table>
              <caption class="visually-hidden">{t("referrals.caption", { group: t(`categories.${g.key}`) })}</caption>
              <thead>
                <tr>
                  <th scope="col">{t("referrals.provider")}</th>
                  <th scope="col">{t("referrals.code")}</th>
                  <th scope="col">{t("referrals.youGet")}</th>
                  <th scope="col">{t("referrals.links")}</th>
                </tr>
              </thead>
              <tbody>
                {g.services.map((s) => (
                  <tr id={`svc-${s.slug}`}>
                    <th scope="row">
                      <span class="ref__name">{s.name}</span>
                      <a class="ref__guide" href={docs.guide(s.slug)} aria-label={t("referrals.guideLabel", { name: s.name })} title={t("referrals.guide")}>
                        <Icon name="book" />
                      </a>
                    </th>
                    <td class:list={{ "ref__empty": !s.code }} data-label={t("referrals.code")}>
                      {s.code && <code dir="ltr">{s.code}</code>}
                    </td>
                    <td class:list={{ "ref__empty": !s.bonusReferee }} data-label={t("referrals.youGet")} lang={bonus(s)?.lang}>
                      {bonus(s)?.text}
                    </td>
                    <td class="ref__links">
                      <a href={s.signupUrl} rel="sponsored noopener">
                        {t("referrals.link")}
                      </a>
                      <span class="url" dir="ltr">{s.signupUrl}</span>
                      <TypedCode t={t} service={s} idPrefix="ref" />
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .ref {
    padding-bottom: var(--section);
  }
  .ref__how {
    max-width: 50rem;
  }
  .ref__how h2 {
    font-size: 1.25rem;
  }
  .ref__how ul {
    display: grid;
    gap: 0.6rem;
    margin: 1rem 0 0;
    padding-inline-start: 1.2rem;
    color: var(--muted);
  }
  .ref__how li::marker {
    color: var(--accent);
  }
  .ref__count {
    margin-top: 2rem;
    color: var(--faint);
    font-size: 0.9375rem;
  }
  .ref__toc ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .ref__toc a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 40px;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    color: var(--text);
    text-decoration: none;
    font-size: 0.9375rem;
  }
  .ref__toc a:hover {
    border-color: var(--accent);
  }
  .ref__toc-count {
    color: var(--muted);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }
  .ref__group {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
  .ref__group > h2 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: clamp(1.4rem, 2.6vw, 1.85rem);
    margin-bottom: 1rem;
  }
  .ref__group > h2 :global(.icon) {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--accent);
  }
  .ref__table {
    margin-top: 1rem;
  }
  .ref__table th,
  .ref__table td {
    padding: 0.8rem 0.9rem;
    font-size: 0.9375rem;
  }
  .ref__table td {
    color: var(--muted);
  }
  .ref__table tbody th {
    white-space: nowrap;
  }
  .ref__name {
    font-weight: 600;
  }
  .ref__guide {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin-inline-start: 0.25rem;
    vertical-align: middle;
    border-radius: 7px;
    color: var(--faint);
  }
  .ref__guide:hover {
    color: var(--accent);
    background: var(--surface-2);
  }
  .ref__guide :global(.icon) {
    width: 1rem;
    height: 1rem;
  }
  .ref__table code {
    overflow-wrap: anywhere;
  }
  .ref__table td:nth-child(2) {
    max-width: 12rem;
  }
  .ref__table td:nth-child(3),
  .ref__table td:nth-child(4) {
    min-width: 9rem;
    max-width: 15rem;
  }
  .ref__links {
    min-width: 14rem;
    max-width: 22rem;
  }
  .ref__links a {
    display: block;
    font-weight: 500;
  }
  .url {
    display: block;
    margin-top: 0.1rem;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }
    /* Phones: one compact card per provider. Empty facts are left out. */
  @media (max-width: 760px) {
    .ref__table {
      border: 0;
      background: none;
      overflow: visible;
    }
    .ref__table thead {
      display: none;
    }
    .ref__table table,
    .ref__table tbody,
    .ref__table tr,
    .ref__table th,
    .ref__table td {
      display: block;
    }
    .ref__table tr {
      margin-bottom: 0.6rem;
      padding: 0.85rem 1rem;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--surface);
    }
    .ref__table tbody th,
    .ref__table td {
      padding: 0;
      border: 0;
      min-width: 0;
      max-width: none;
    }
    .ref__table tbody th {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      white-space: normal;
    }
    .ref__table td {
      margin-top: 0.3rem;
      font-size: 0.875rem;
    }
    .ref__table td.ref__empty {
      display: none;
    }
    .ref__table td[data-label]::before {
      content: attr(data-label) ": ";
      color: var(--faint);
    }
    .ref__links {
      margin-top: 0.6rem !important;
    }
  }
</style>
